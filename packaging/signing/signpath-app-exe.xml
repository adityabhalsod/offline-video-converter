<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the app executable.
  Create it in SignPath (Project > Artifact configurations) with the slug "app-exe"
  and paste this content. The workflow uploads a zip containing only this exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="OfflineVideoConverter.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
