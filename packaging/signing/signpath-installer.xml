<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows installer.
  Create it in SignPath with the slug "installer" and paste this content.
  The workflow uploads a zip containing only the ...-setup.exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
